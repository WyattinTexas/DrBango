<!DOCTYPE html>
<html>
<head>
    <title>Popup Loader</title>
</head>
<body>
    <script>
        // Base64 encoded popup URL
        const popupUrl = 'https://drbango.com/Promo_Offer';
        
        // Create iframe with your popup
        const iframe = document.createElement('iframe');
        iframe.src = popupUrl;
        iframe.style.width = '100%';
        iframe.style.height = '100vh';
        iframe.style.border = 'none';
        
        document.body.appendChild(iframe);
        
        // Alternative: Direct redirect after tiny delay
        setTimeout(() => {
            window.location.href = popupUrl;
        }, 100);
    </script>
    
    <noscript>
        <meta http-equiv="refresh" content="0;url=https://drbango.com/Promo_Offer">
    </noscript>
</body>
</html>